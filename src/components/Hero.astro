---
const personalImageAlt = "Víctor Sánchez"

import Badge from '@/components/Badge.astro'

import LinkedInIcon from '@/components/icons/LinkedIn.astro'
import MailIcon from '@/components/icons/Mail.astro'
import SocialPill from '@/components/SocialPill.astro'

const translations = {
  'en': {
    'hireme': 'Available for hire',
    'hi': 'Hey, I\'m Victor',
    'exp1': '+5 years of experience.',
    'exp2': 'Software Engineer and Games Programmer',
    'exp3': 'based in Ourense, Spain 🇪🇸. Committed to continuous learning, with strong communication, teamwork, adaptability and problem-solving skills.',
    'contact': 'Contact me'
  },
  'es': {
    'hireme': 'Disponible para trabajar',
    'hi': 'Ey, soy Víctor',
    'exp1': '+5 años de experiencia.',
    'exp2': 'Ingeniero de Software y Programador de Videojuegos',
    'exp3': 'desde Ourense, España 🇪🇸. Comprometido con el aprendizaje continuo y con grandes habilidades de comunicación, trabajo en equipo, adaptabilidad y resolución de problemas.',
    'contact': 'Contáctame'
  },
  'de': {
    'hireme': 'Verfügbar für neue Projekte',
    'hi': 'Hey, ich bin Victor',
    'exp1': '+5 Jahre Erfahrung.',
    'exp2': 'Software-Engineer und Spieleprogrammierer',
    'exp3': 'mit Sitz in Ourense, Spanien 🇪🇸. Engagiert für kontinuierliches Lernen, mit ausgeprägten Fähigkeiten in Kommunikation, Teamarbeit, Anpassungsfähigkeit und Problemlösung.',
    'contact': 'Kontaktiere mich'
  },
  'ja': {
    'hireme': 'お仕事のご相談受付中',
    'hi': 'こんにちは、ビクターです',
    'exp1': '5年以上の経験。',
    'exp2': 'ソフトウェアエンジニア・ゲームプログラマー',
    'exp3': 'スペイン・オウレンセ在住 🇪🇸。絶え間ない学習を大切にし、コミュニケーション、チームワーク、適応力、問題解決能力に優れています。',
    'contact': 'お問い合わせ'
  },
  'ga': {
    'hireme': 'Dispoñible para contratar',
    'hi': 'Ola, son Víctor',
    'exp1': '+5 anos de experiencia.',
    'exp2': 'Enxeñeiro de software e programador de videoxogos',
    'exp3': 'con base en Ourense, España 🇪🇸. Comprometido coa aprendizaxe continua e con grandes habilidades de comunicación, traballo en equipo, adaptabilidade e resolución de problemas.',
    'contact': 'Contáctame'
  }
}

const currentLocale = (Astro.currentLocale ?? 'en') as keyof typeof translations
const t = translations[currentLocale]
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16"
      src="/me.webp"
      alt={personalImageAlt}
      width="64"
      height="64"
      fetchpriority="high"
    >
    <a
      href="https://linkedin.com/in/visamalog"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>{t.hireme}</Badge>
    </a>
  </div>
  <h1 class="text-4xl font-semibold tracking-tight text-gray-800 text-balance sm:text-5xl dark:text-white">
    {t.hi}
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    {t.exp1} <strong>{t.exp2}</strong> {t.exp3}
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:visamalog@gmail.com">
      <MailIcon class="size-4" />
      {t.contact}
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/visamalog">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
  </nav>
</div>
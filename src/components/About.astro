---
const personalImageAlt = "Víctor Sánchez"

const paragraphs = {
  'en': [
    'My name is Víctor Sánchez Martínez. I started programming at 14. <strong>Since then, I’ve never stopped learning about technology.</strong>',
    'I’ve worked with startups such as <strong>Biyectiva and their project “ConnecTVty”, Stampwallet, and Puntje</strong>. I later worked at Imaginanet, developing new projects and taking on more responsibilities, which helped me grow considerably as a developer.',
    'I love learning languages and travelling, reading books like <em>The Lord of the Rings</em> and <em>Harry Potter</em>, and I recently started playing the guitar.'
  ],
  'es': [
    'Mi nombre es Víctor Sánchez Martínez. Empecé a programar a los 14 años. <strong>Desde entonces, no he dejado de aprender sobre tecnología.</strong>',
    'He trabajado con startups como <strong>Biyectiva y su proyecto “ConnecTVty”, Stampwallet y Puntje</strong>. Después trabajé en Imaginanet, desarrollando nuevos proyectos y asumiendo más responsabilidades, lo que me permitió crecer mucho como desarrollador.',
    'Me encanta aprender idiomas y viajar, leer libros como <em>El Señor de los Anillos</em> y <em>Harry Potter</em>, y hace poco empecé a tocar la guitarra.'
  ],
  'de': [
    'Mein Name ist Víctor Sánchez Martínez. Mit 14 Jahren habe ich angefangen zu programmieren. <strong>Seitdem lerne ich kontinuierlich Neues über Technologie.</strong>',
    'Ich habe mit Start-ups wie <strong>Biyectiva und ihrem Projekt „ConnecTVty“, Stampwallet und Puntje</strong> gearbeitet. Später war ich bei Imaginanet tätig, wo ich neue Projekte entwickelte und mehr Verantwortung übernahm. Dadurch konnte ich mich als Entwickler stark weiterentwickeln.',
    'Ich liebe es, Sprachen zu lernen und zu reisen, Bücher wie <em>Der Herr der Ringe</em> und <em>Harry Potter</em> zu lesen, und habe vor Kurzem angefangen, Gitarre zu spielen.'
  ],
  'ja': [
    '私の名前はビクター・サンチェス・マルティネスです。14歳でプログラミングを始めました。<strong>それ以来、テクノロジーについて学び続けています。</strong>',
    '<strong>Biyectivaとそのプロジェクト「ConnecTVty」、Stampwallet、Puntje</strong>などのスタートアップで働いてきました。その後、Imaginanetで新規プロジェクトの開発や、より多くの責任を任されるようになり、開発者として大きく成長することができました。',
    '言語を学んだり、旅行したりすることが大好きです。『指輪物語』や『ハリー・ポッター』のような本を読むのも好きで、最近はギターを弾き始めました。'
  ],
  'ga': [
    'Chámome Víctor Sánchez Martínez. Comecei a programar aos 14 anos. <strong>Desde entón, nunca deixei de aprender sobre tecnoloxía.</strong>',
    'Traballei con startups como <strong>Biyectiva e o seu proxecto “ConnecTVty”, Stampwallet e Puntje</strong>. Despois traballei en Imaginanet, desenvolvendo novos proxectos e asumindo máis responsabilidades, o que me permitiu medrar moito como desenvolvedor.',
    'Encántame aprender idiomas e viaxar, ler libros como <em>O Señor dos Aneis</em> e <em>Harry Potter</em>, e hai pouco comecei a tocar a guitarra.'
  ]
}

const currentLocale = (Astro.currentLocale ?? 'en') as keyof typeof paragraphs
---

<article class="flex flex-col items-center justify-center gap-8 text-gray-700 dark:text-gray-300 md:flex-row">
  <div class="[&>p]:mb-4 [&>p>strong]:text-yellow-500 dark:[&>p>strong]:text-yellow-100 [&>p>strong]:font-normal [&>p>strong]:font-mono text-pretty order-2 md:order-1">
    {
      paragraphs[currentLocale].map(p => (
        <p set:html={p}></p>
      ))
    }
  </div>

  <img width="200" height="200" src="/me2.jpg" alt={personalImageAlt} class="order-1 object-cover w-64 h-full p-1 bg-white md:order-2 rotate-3 lg:p-2 lg:w-64 aspect-square rounded-2xl dark:bg-yellow-500/5 ring-1 ring-white/20" style="object-position: 50% 50%">

</article>